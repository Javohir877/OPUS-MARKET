{
  "name": "opus-market-api",
  "private": true,
  "type": "module",
  "description": "OPUS MARKET backend: akkauntlar, buyurtmalar, katalog va admin API (Cloudflare Workers + D1)",
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "db:local": "wrangler d1 execute opus-market --local --file schema.sql",
    "db:remote": "wrangler d1 execute opus-market --remote --file schema.sql",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.148.0"
  }
}
